# Server
PORT=3000

# Relying Party (WebAuthn) config
RP_NAME=My WebAuthn App
RP_ID=localhost
ORIGIN=http://localhost:3000

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# --- WebAuthn / FIDO2 server provider ---
# simple          -> verify locally with @simplewebauthn/server (no external deps, dev/demo)
# powerauth-cloud -> delegate verification to PowerAuth Cloud (Talisman hard-token architecture)
WEBAUTHN_PROVIDER=simple

# --- PowerAuth Cloud (only used when WEBAUTHN_PROVIDER=powerauth-cloud) ---
POWERAUTH_CLOUD_BASE_URL=https://your-powerauth-cloud.example.com
POWERAUTH_CLOUD_APP_ID=your-app-id
POWERAUTH_CLOUD_AUTH_TYPE=basic
POWERAUTH_CLOUD_USERNAME=your-api-username
POWERAUTH_CLOUD_PASSWORD=your-api-password
# POWERAUTH_CLOUD_TOKEN=your-bearer-token   # used instead of username/password when AUTH_TYPE=bearer
POWERAUTH_CLOUD_LOGIN_TEMPLATE=login
# Set to true to log raw PowerAuth Cloud request/response payloads and the
# final WebAuthn options sent to the browser — useful when troubleshooting
# against a real deployment. Never enable in production.
DEBUG_POWERAUTH=false
